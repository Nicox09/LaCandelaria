---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import { Image } from "astro:assets";
import { languages, type Lang } from "../../i18n/ui";
import { useTranslations } from "../../i18n/utils";

import heroImg from "../../assets/img/salame-3.jpg";
import salame1 from "../../assets/img/salame-1.jpg";
import salame2 from "../../assets/img/salame-2.jpg";
import salame3 from "../../assets/img/salame-3.jpg";
import davidImg from "../../assets/img/david-trabajo.jpg";
import chefImg from "../../assets/img/chef.jpg";
import gastroImg from "../../assets/img/plato-crudo.jpg";

const cortesImgs: Record<string, ImageMetadata> = { salame2, david: davidImg, chef: chefImg };

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);
const productos = t("productos");
const meta = t("meta");
---

<Layout lang={lang} title={`${productos.h1} — La Candelaria`} description={meta.description}>
  <main id="main">
    <!-- HERO -->
    <div class="relative isolate overflow-hidden min-h-[500px] flex flex-col">
      <Image src={heroImg} alt="" class="absolute inset-0 w-full h-full object-cover scale-110 blur-sm brightness-[0.5]" loading="eager" fetchpriority="high" widths={[640, 1024, 1600]} sizes="100vw" />
      <div class="absolute inset-0 bg-gradient-to-b from-trocha/10 via-trocha/40 to-trocha/85"></div>
      <Navbar lang={lang} active="productos" variant="onPhoto" />
      <div class="relative mx-auto max-w-[1440px] px-6 md:px-10 pt-32 pb-16 flex-1 flex flex-col justify-end">
        <p class="text-sm font-bold tracking-widest text-[#ecc7ab] mb-4">{productos.eyebrow}</p>
        <h1 class="font-display font-black text-5xl md:text-6xl text-lana-card max-w-2xl">{productos.h1}</h1>
        <p class="mt-5 max-w-xl text-lg text-[#e9e0d1] leading-relaxed">{productos.intro}</p>
      </div>
    </div>

    <!-- CORTES -->
    <section class="bg-lana">
      <div class="mx-auto max-w-[1440px] px-6 md:px-10 py-20">
        <p class="text-sm font-bold tracking-widest text-tierra mb-3">{productos.cortesEyebrow}</p>
        <h2 class="font-display font-black text-4xl md:text-5xl mb-12">{productos.cortesTitle}</h2>
        <div class="grid md:grid-cols-3 gap-7">
          {productos.cortes.map((c) => (
            <div class="bg-[#e8dcc6]">
              <Image src={cortesImgs[c.img]} alt={c.name} class="w-full h-[260px] object-cover" widths={[350, 500, 700]} sizes="(min-width: 768px) 33vw, 100vw" />
              <div class="p-7">
                <h3 class="font-display font-bold text-2xl">{c.name}</h3>
                <p class="text-tierra font-bold text-sm mt-1 mb-4">{c.weight}</p>
                <ul class="space-y-2">
                  {c.feats.map((f) => (
                    <li class="flex items-start gap-2 text-sm text-piedra">
                      <span class="mt-2 w-1.5 h-1.5 rounded-full bg-tierra shrink-0"></span>
                      {f}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- SALAME -->
    <section class="bg-[#e8dcc6]">
      <div class="mx-auto max-w-[1440px] px-6 md:px-10 py-20">
        <p class="text-sm font-bold tracking-widest text-tierra mb-3">{productos.salameEyebrow}</p>
        <h2 class="font-display font-black text-4xl md:text-5xl mb-12">{productos.salameTitle}</h2>
        <div class="grid md:grid-cols-[1.1fr_1fr] gap-10 items-start">
          <div class="grid grid-cols-2 gap-4">
            <Image src={salame1} alt="Salame de llama" class="col-span-2 w-full h-[300px] object-cover" widths={[400, 600, 900]} sizes="(min-width: 768px) 50vw, 100vw" />
            <Image src={salame2} alt="" class="w-full h-[180px] object-cover" widths={[250, 400]} sizes="240px" />
            <Image src={salame3} alt="" class="w-full h-[180px] object-cover" widths={[250, 400]} sizes="240px" />
          </div>
          <div>
            <p class="text-lg text-piedra leading-relaxed mb-8">{productos.salameText}</p>
            <div class="space-y-5">
              {productos.salameSpecs.map((s) => (
                <div>
                  <p class="font-bold text-tierra">{s.k}</p>
                  <p class="text-piedra">{s.v}</p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- QUALITY COMPARISON -->
    <section class="bg-lana">
      <div class="mx-auto max-w-[1440px] px-6 md:px-10 py-20">
        <p class="text-sm font-bold tracking-widest text-tierra mb-3">{productos.qualityEyebrow}</p>
        <h2 class="font-display font-black text-4xl md:text-5xl mb-14 max-w-2xl">{productos.qualityTitle}</h2>
        <div class="grid md:grid-cols-3 gap-12">
          {productos.qualityRows.map((row) => {
            const max = Math.max(...row.items.map((it) => it[1] as number));
            return (
              <div>
                <h3 class="font-bold text-lg mb-5">{row.title}</h3>
                <div class="space-y-3">
                  {row.items.map(([name, value]) => (
                    <div>
                      <div class="flex justify-between text-sm mb-1">
                        <span class={name === "Llama" || name === "Lama" ? "font-bold text-trocha" : "text-piedra"}>{name}</span>
                        <span class="text-piedra">{value}</span>
                      </div>
                      <div class="h-2.5 bg-[#e3d6bf] rounded-full overflow-hidden">
                        <div
                          class={`h-full rounded-full ${name === "Llama" || name === "Lama" ? "bg-tierra" : "bg-piedra"}`}
                          style={`width:${((value as number) / max) * 100}%`}
                        ></div>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- GASTRO -->
    <section class="relative isolate overflow-hidden">
      <Image src={gastroImg} alt="" class="absolute inset-0 w-full h-full object-cover scale-110 blur-sm brightness-[0.55]" widths={[640, 1024, 1600]} sizes="100vw" />
      <div class="absolute inset-0 bg-gradient-to-r from-trocha/90 via-trocha/70 to-trocha/30"></div>
      <div class="relative mx-auto max-w-[1440px] px-6 md:px-10 py-24 grid md:grid-cols-2 gap-10 items-center">
        <div>
          <p class="text-sm font-bold tracking-widest text-[#ecc7ab] mb-3">{productos.gastroEyebrow}</p>
          <h2 class="font-display font-black text-4xl text-lana-card mb-5">{productos.gastroTitle}</h2>
          <p class="text-lg text-[#e9e0d1] max-w-md leading-relaxed">{productos.gastroText}</p>
        </div>
      </div>
    </section>

    <Footer lang={lang} />
  </main>
</Layout>

---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import { Image } from "astro:assets";
import { languages, type Lang } from "../../i18n/ui";
import { useTranslations, useTranslatedPath } from "../../i18n/utils";

import heroImg from "../../assets/img/llamas-campo-1.jpg";
import introImg from "../../assets/img/llamas-campo-2.jpg";
import quoteImg from "../../assets/img/plato-crudo.jpg";
import salame1 from "../../assets/img/salame-1.jpg";
import salame2 from "../../assets/img/salame-2.jpg";
import salame3 from "../../assets/img/salame-3.jpg";
import davidImg from "../../assets/img/david-trabajo.jpg";

const productImgs: Record<string, ImageMetadata> = {
  salame1, salame2, salame3, david: davidImg,
};

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);
const tp = useTranslatedPath(lang);
const home = t("home");
const common = t("common");
---

<Layout lang={lang}>
  <main id="main">
    <!-- HERO -->
    <div class="relative isolate overflow-hidden min-h-[820px] flex flex-col">
      <Image src={heroImg} alt="" class="absolute inset-0 w-full h-full object-cover scale-110 blur-sm brightness-[0.55] saturate-[1.15]" loading="eager" fetchpriority="high" widths={[640, 1024, 1600, 2400]} sizes="100vw" />
      <div class="absolute inset-0 bg-gradient-to-b from-trocha/10 via-trocha/40 to-trocha/85"></div>

      <Navbar lang={lang} active="inicio" variant="onPhoto" />

      <div class="relative mx-auto max-w-[1440px] px-6 md:px-10 pt-40 pb-24 flex-1 flex flex-col justify-end">
        <p class="text-[13px] md:text-sm font-bold tracking-widest text-[#ecc7ab] mb-4">{home.eyebrow}</p>
        <h1 class="font-display font-black text-5xl sm:text-6xl md:text-7xl leading-[1.05] text-lana-card max-w-3xl">
          {home.h1.map((line) => <span class="block">{line}</span>)}
        </h1>
        <p class="mt-6 max-w-xl text-lg text-[#e9e0d1] leading-relaxed">{home.intro}</p>

        <div class="mt-9 flex flex-wrap gap-4 items-center">
          <a href={tp("/productos/")} class="rounded-full bg-tierra hover:bg-tierra-dark transition-colors px-8 py-4 font-bold text-lana-card">
            {common.ctaProducts}
          </a>
          <a href={tp("/historia/")} class="rounded-full border-2 border-lana-card px-8 py-4 font-bold text-lana-card hover:bg-white/10 transition-colors">
            {common.ctaHistory}
          </a>
        </div>

        <div class="mt-14 flex gap-10 flex-wrap">
          {home.stats.map((s) => (
            <div>
              <p class="font-display font-bold text-3xl text-lana-card">{s.num}</p>
              <p class="text-sm text-[#dcc9b8]">{s.label}</p>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- INTRO / HISTORIA -->
    <section class="bg-lana">
      <div class="mx-auto max-w-[1440px] px-6 md:px-10 py-24 grid md:grid-cols-[480px_1fr] gap-12 items-start">
        <Image src={introImg} alt="Llamas en la puna jujeña" class="w-full h-[360px] object-cover" widths={[400, 600, 960]} sizes="(min-width: 768px) 480px, 100vw" />
        <div>
          <p class="text-sm font-bold tracking-widest text-tierra mb-3">{home.historyEyebrow}</p>
          <h2 class="font-display font-black text-4xl md:text-5xl mb-6">{home.historyTitle}</h2>
          <p class="text-lg text-piedra leading-relaxed mb-5 max-w-2xl">{home.historyText1}</p>
          <p class="text-lg text-piedra leading-relaxed mb-8 max-w-2xl">{home.historyText2}</p>
          <a href={tp("/historia/")} class="inline-flex items-center gap-2 font-bold text-tierra hover:gap-3 transition-all">
            {home.historyLink} <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>

    <!-- PRODUCT PREVIEW -->
    <section class="bg-[#e6dac4]">
      <div class="mx-auto max-w-[1440px] px-6 md:px-10 py-24">
        <p class="text-sm font-bold tracking-widest text-tierra mb-3">{home.productsEyebrow}</p>
        <h2 class="font-display font-black text-4xl md:text-5xl mb-12">{home.productsTitle}</h2>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {home.products.map((p) => (
            <div class="bg-lana-card flex flex-col">
              <Image src={productImgs[p.img]} alt={p.name} class="w-full h-[220px] object-cover" widths={[300, 450, 600]} sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw" />
              <div class="p-6 flex-1 flex flex-col">
                <h3 class="font-display font-bold text-xl">{p.name}</h3>
                <p class="text-tierra font-bold text-sm mt-1 mb-3">{p.weight}</p>
                <p class="text-sm text-piedra leading-relaxed">{p.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- QUOTE -->
    <section class="relative isolate overflow-hidden">
      <div class="mx-auto max-w-[1440px] px-6 md:px-10 py-20 grid md:grid-cols-[1fr_420px] gap-10 items-center bg-trocha">
        <div>
          <p class="font-display italic text-2xl md:text-3xl text-lana-card leading-snug">“{home.quote}”</p>
          <p class="mt-5 text-sm text-lana/60">— {home.quoteAuthor}</p>
        </div>
        <Image src={quoteImg} alt="Plato de crudo de llama, El Baqueano" class="w-full h-[280px] object-cover" widths={[320, 480, 640]} sizes="420px" />
      </div>
    </section>

    <Footer lang={lang} />
  </main>
</Layout>

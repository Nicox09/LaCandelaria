---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import { Image } from "astro:assets";
import { languages, type Lang } from "../../i18n/ui";
import { useTranslations } from "../../i18n/utils";

import heroImg from "../../assets/img/llamas-campo-2.jpg";
import introImg from "../../assets/img/llamas-campo-1.jpg";
import awardImg from "../../assets/img/award-2006.jpg";
import davidImg from "../../assets/img/david-trabajo.jpg";
import salame2 from "../../assets/img/salame-2.jpg";
import impactImg from "../../assets/img/llamas-campo-1.jpg";

const eventImgs = [introImg, heroImg, awardImg, davidImg, salame2];

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);
const historia = t("historia");
const meta = t("meta");
---

<Layout lang={lang} title={`${historia.h1a} ${historia.h1b} — La Candelaria`} description={meta.description}>
  <main id="main">
    <!-- HERO -->
    <div class="relative isolate overflow-hidden min-h-[560px] flex flex-col">
      <Image src={heroImg} alt="" class="absolute inset-0 w-full h-full object-cover scale-110 blur-sm brightness-[0.55] saturate-[1.1]" loading="eager" fetchpriority="high" widths={[640, 1024, 1600, 2400]} sizes="100vw" />
      <div class="absolute inset-0 bg-gradient-to-b from-trocha/10 via-trocha/40 to-trocha/85"></div>
      <Navbar lang={lang} active="historia" variant="onPhoto" />
      <div class="relative mx-auto max-w-[1440px] px-6 md:px-10 pt-36 pb-20 flex-1 flex flex-col justify-end">
        <p class="text-sm font-bold tracking-widest text-[#ecc7ab] mb-4">{historia.eyebrow}</p>
        <h1 class="font-display font-black text-5xl md:text-6xl leading-[1.08] text-lana-card max-w-2xl">
          <span class="block">{historia.h1a}</span>
          <span class="block">{historia.h1b}</span>
        </h1>
      </div>
    </div>

    <!-- INTRO -->
    <section class="bg-lana">
      <div class="mx-auto max-w-[1440px] px-6 md:px-10 py-20 grid md:grid-cols-[1fr_380px] gap-12 items-center">
        <p class="text-lg text-trocha leading-relaxed max-w-2xl">{historia.introText}</p>
        <Image src={introImg} alt="" class="w-full h-[260px] object-cover" widths={[300, 460, 760]} sizes="380px" />
      </div>
    </section>

    <!-- TIMELINE -->
    <section class="bg-[#e8dcc6]">
      <div class="mx-auto max-w-[1440px] px-6 md:px-10 py-20">
        <p class="text-sm font-bold tracking-widest text-tierra mb-3">{historia.timelineEyebrow}</p>
        <h2 class="font-display font-black text-4xl md:text-5xl mb-16">{historia.timelineTitle}</h2>

        <ol class="relative border-l-[3px] border-tierra ml-2 md:ml-8 space-y-16">
          {historia.events.map((ev, i) => (
            <li class="relative pl-10 md:pl-14">
              <span class="absolute -left-[11px] top-1 w-5 h-5 rounded-full bg-tierra ring-4 ring-[#e8dcc6]"></span>
              <div class="grid md:grid-cols-[1fr_240px] gap-8 items-start">
                <div>
                  <p class="font-display font-bold text-tierra text-xl mb-1">{ev.year}</p>
                  <h3 class="font-display font-bold text-2xl md:text-3xl mb-3">{ev.title}</h3>
                  <p class="text-piedra leading-relaxed max-w-2xl">{ev.desc}</p>
                </div>
                <Image src={eventImgs[i]} alt="" class="w-full h-[170px] object-cover" widths={[200, 300, 480]} sizes="240px" />
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- IMPACT -->
    <section class="relative isolate overflow-hidden">
      <Image src={impactImg} alt="" class="absolute inset-0 w-full h-full object-cover scale-110 blur-sm brightness-[0.5]" widths={[640, 1024, 1600]} sizes="100vw" />
      <div class="absolute inset-0 bg-chile/70"></div>
      <div class="relative mx-auto max-w-[1440px] px-6 md:px-10 py-24">
        <p class="text-sm font-bold tracking-widest text-[#f0cdbe] mb-3">{historia.impactEyebrow}</p>
        <h2 class="font-display font-black text-4xl md:text-5xl text-lana-card max-w-3xl mb-6">{historia.impactTitle}</h2>
        <p class="text-lg text-[#e8d8cd] max-w-2xl leading-relaxed">{historia.impactText}</p>
      </div>
    </section>

    <Footer lang={lang} />
  </main>
</Layout>

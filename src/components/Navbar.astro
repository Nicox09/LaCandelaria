---
import { languages, type Lang } from "../i18n/ui";
import { useTranslations } from "../i18n/utils";

interface Props {
  lang: Lang;
  active: "inicio" | "historia" | "productos" | "contacto";
  variant?: "onPhoto" | "solid";
}

const { lang, active, variant = "onPhoto" } = Astro.props;
const t = useTranslations(lang);
const nav = t("nav");

const pageSlug: Record<string, string> = {
  inicio: "",
  historia: "historia",
  productos: "productos",
  contacto: "contacto",
};

function pathFor(l: string, page: string) {
  const slug = pageSlug[page];
  return slug ? `/${l}/${slug}/` : `/${l}/`;
}

// path actual sin el prefijo de idioma, para el selector de idiomas
const parts = Astro.url.pathname.split("/").filter(Boolean);
const restPath = parts.slice(1).join("/");

const isOnPhoto = variant === "onPhoto";
---

<header class={isOnPhoto ? "absolute inset-x-0 top-0 z-40" : "relative z-40 bg-lana border-b border-piedra-line"}>
  <nav class="mx-auto max-w-[1440px] px-6 md:px-10 h-24 flex items-center justify-between">
    <a href={pathFor(lang, "inicio")} class="flex items-center gap-3 group">
      <img
        src={isOnPhoto ? "/img/logo-mark-light.png" : "/img/logo-mark-dark.png"}
        alt="La Candelaria"
        class="h-9 w-auto"
      />
      <span class="flex flex-col leading-none">
        <span class={`font-display italic font-semibold text-xl ${isOnPhoto ? "text-lana-card" : "text-trocha"}`}>
          La Candelaria
        </span>
        <span class={`text-[10px] tracking-widest ${isOnPhoto ? "text-lana-card/70" : "text-piedra"}`}>
          {nav.tagline}
        </span>
      </span>
    </a>

    <ul class={`hidden lg:flex items-center gap-9 font-body text-[15px] font-medium ${isOnPhoto ? "text-lana-card" : "text-piedra"}`}>
      {(["inicio", "historia", "productos", "contacto"] as const).map((key) => (
        <li>
          <a
            href={pathFor(lang, key)}
            class={`pb-1 border-b-2 transition-colors ${
              active === key
                ? `border-tierra ${isOnPhoto ? "text-lana-card" : "text-trocha"}`
                : "border-transparent hover:border-tierra/50"
            }`}
          >
            {nav[key]}
          </a>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-4">
      <div class={`hidden md:flex items-center gap-1 text-sm font-bold ${isOnPhoto ? "text-lana-card" : "text-piedra"}`}>
        {Object.keys(languages).map((l) => (
          <a
            href={`/${l}/${restPath}`}
            class={`px-2.5 py-1 rounded-full transition-colors ${
              l === lang
                ? "bg-tierra text-lana-card"
                : "hover:bg-trocha/10"
            }`}
          >
            {l.toUpperCase()}
          </a>
        ))}
      </div>

      <button
        id="menu-toggle"
        class={`lg:hidden inline-flex flex-col justify-center gap-1.5 w-9 h-9 ${isOnPhoto ? "text-lana-card" : "text-trocha"}`}
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="block h-0.5 w-6 bg-current"></span>
        <span class="block h-0.5 w-6 bg-current"></span>
        <span class="block h-0.5 w-6 bg-current"></span>
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="hidden lg:hidden bg-trocha text-lana-card px-6 pb-6 pt-2">
    <ul class="flex flex-col gap-1 font-body text-base">
      {(["inicio", "historia", "productos", "contacto"] as const).map((key) => (
        <li>
          <a href={pathFor(lang, key)} class={`block py-3 border-b border-white/10 ${active === key ? "text-tierra" : ""}`}>
            {nav[key]}
          </a>
        </li>
      ))}
    </ul>
    <div class="flex gap-2 pt-4">
      {Object.keys(languages).map((l) => (
        <a
          href={`/${l}/${restPath}`}
          class={`px-3 py-1.5 rounded-full text-sm font-bold ${l === lang ? "bg-tierra" : "bg-white/10"}`}
        >
          {l.toUpperCase()}
        </a>
      ))}
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  btn?.addEventListener("click", () => {
    const isHidden = menu?.classList.contains("hidden");
    menu?.classList.toggle("hidden");
    btn.setAttribute("aria-expanded", String(!!isHidden));
  });
</script>

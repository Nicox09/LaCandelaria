---
import { type Lang } from "../i18n/ui";
import { useTranslations } from "../i18n/utils";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const nav = t("nav");
const footer = t("footer");
const contacto = t("contacto");

const pageSlug: Record<string, string> = {
  inicio: "",
  historia: "historia",
  productos: "productos",
  contacto: "contacto",
};
function pathFor(page: string) {
  const slug = pageSlug[page];
  return slug ? `/${lang}/${slug}/` : `/${lang}/`;
}
---

<footer class="bg-trocha text-lana-card">
  <div class="mx-auto max-w-[1440px] px-6 md:px-10 py-16 grid gap-10 md:grid-cols-[1.3fr_1fr_1fr]">
    <div>
      <div class="flex items-center gap-3">
        <img src="/img/logo-mark-light.png" alt="La Candelaria" class="h-8 w-auto" />
        <span class="font-display italic font-semibold text-2xl">La Candelaria</span>
      </div>
      <p class="mt-4 text-sm text-lana/70 max-w-sm leading-relaxed">{footer.addr}</p>
    </div>

    <div>
      <h3 class="font-body font-bold text-sm mb-4 tracking-wide">{footer.siteTitle}</h3>
      <ul class="space-y-2 text-sm text-lana/70">
        {(["inicio", "historia", "productos", "contacto"] as const).map((key) => (
          <li><a href={pathFor(key)} class="hover:text-tierra transition-colors">{nav[key]}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <h3 class="font-body font-bold text-sm mb-4 tracking-wide">{footer.contactTitle}</h3>
      <ul class="space-y-2 text-sm text-lana/70">
        <li><a href="mailto:llamaslacandelaria@gmail.com" class="hover:text-tierra transition-colors">llamaslacandelaria@gmail.com</a></li>
        <li><a href="https://wa.me/5493814012399" class="hover:text-tierra transition-colors">+54 9 381 401 2399</a></li>
        <li><a href="https://instagram.com/llamaslacandelaria" target="_blank" rel="noopener" class="hover:text-tierra transition-colors">@llamaslacandelaria</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="mx-auto max-w-[1440px] px-6 md:px-10 py-5 flex flex-col sm:flex-row gap-2 justify-between text-xs text-lana/50">
      <p>{footer.legal}</p>
      <p>ES · EN · IT</p>
    </div>
  </div>
</footer>

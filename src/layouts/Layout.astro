---
import "../styles/global.css";
import { languages, type Lang } from "../i18n/ui";
import { useTranslations } from "../i18n/utils";

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
}

const { lang, title, description } = Astro.props;
const t = useTranslations(lang);
const meta = t("meta");
const common = t("common");
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title ?? meta.title}</title>
    <meta name="description" content={description ?? meta.description} />

    <!-- hreflang para SEO multi-idioma -->
    {Object.keys(languages).map((l) => (
      <link rel="alternate" hreflang={l} href={`https://lacandelaria.pages.dev${Astro.url.pathname.replace(/^\/(es|en|it)/, `/${l}`)}`} />
    ))}

    <meta property="og:title" content={title ?? meta.title} />
    <meta property="og:description" content={description ?? meta.description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/og-image.jpg" />
  </head>
  <body>
    <a href="#main" class="skip-link">{common.skipToContent}</a>
    <slot />
  </body>
</html>
